{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm install - banking-web",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/app/frontend/banking-web"
      },
      "problemMatcher": []
    },
    {
      "label": "run account mcp dev",
      "type": "shell",
      "command": "rtk proxy uv run --env-file .env python -u ..\\..\\..\\.vscode\\run-local-service.py account",
      "options": {
        "cwd": "${workspaceFolder}/app/business-api/account",
        "env": {
          "SSL_CERT_FILE": "${env:USERPROFILE}\\.banking-oauth-local\\localhost-ca-bundle.pem",
          "PROFILE": "dev"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "account-mcp",
        "clear": true
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": "^(.+):(\\d+): (.+)$",
            "file": 1,
            "line": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Starting account service server with profile: dev, port: 8070.*",
          "endsPattern": ".*Uvicorn running on http://0\\.0\\.0\\.0:8070.*"
        }
      }
    },
    {
      "label": "run transaction mcp dev",
      "type": "shell",
      "command": "rtk proxy uv run --env-file .env python -u ..\\..\\..\\.vscode\\run-local-service.py transaction",
      "options": {
        "cwd": "${workspaceFolder}/app/business-api/transaction",
        "env": {
          "SSL_CERT_FILE": "${env:USERPROFILE}\\.banking-oauth-local\\localhost-ca-bundle.pem",
          "PROFILE": "dev"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "transaction-mcp",
        "clear": true
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": "^(.+):(\\d+): (.+)$",
            "file": 1,
            "line": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Starting transaction service server with profile: dev, port: 8071.*",
          "endsPattern": ".*Uvicorn running on http://0\\.0\\.0\\.0:8071.*"
        }
      }
    },
    {
      "label": "run responses agent dev",
      "type": "shell",
      "command": "rtk proxy uv run --env-file .env python -u ..\\..\\.vscode\\run-local-service.py agent",
      "options": {
        "cwd": "${workspaceFolder}/app/agent",
        "env": {
          "SSL_CERT_FILE": "${env:USERPROFILE}\\.banking-oauth-local\\localhost-ca-bundle.pem",
          "ENABLE_SENSITIVE_DATA": "true",
          "OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT": "true",
          "AGENT_RUNTIME": "local"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "responses-agent",
        "clear": true
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": "^(.+):(\\d+): (.+)$",
            "file": 1,
            "line": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*AgentServerHost starting.*",
          "endsPattern": ".*(?:Uvicorn running|Running) on http://(?:127\\.0\\.0\\.1|0\\.0\\.0\\.0):8088.*"
        }
      }
    },
    {
      "label": "run responses bff dev",
      "type": "shell",
      "command": "rtk proxy uv run --env-file .env python -u ..\\..\\.vscode\\run-local-service.py bff",
      "options": {
        "cwd": "${workspaceFolder}/app/responses-bff",
        "env": {
          "SSL_CERT_FILE": "${env:USERPROFILE}\\.banking-oauth-local\\localhost-ca-bundle.pem",
          "PROFILE": "dev",
          "RESPONSES_UPSTREAM_MODE": "local",
          "RESPONSES_AGENT_ENDPOINT": "http://127.0.0.1:8088/responses"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "responses-bff",
        "clear": true
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": "^(.+):(\\d+): (.+)$",
            "file": 1,
            "line": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Started server process.*",
          "endsPattern": ".*Uvicorn running on http://127\\.0\\.0\\.1:8080.*|.*Uvicorn running on http://0\\.0\\.0\\.0:8080.*"
        }
      }
    },
    {
      "label": "run frontend dev",
      "type": "shell",
      "command": "rtk proxy npm run dev -- --mode oauth-local",
      "dependsOn": "prepare local OAuth TLS",
      "options": {
        "cwd": "${workspaceFolder}/app/frontend/banking-web"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "frontend-dev",
        "clear": true
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": "^(.+):(\\d+): (.+)$",
            "file": 1,
            "line": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE.*",
          "endsPattern": ".*Local:.*https://localhost:5170/.*"
        }
      }
    },
    {
      "label": "prepare local OAuth TLS",
      "type": "shell",
      "command": "rtk proxy pwsh -NoProfile -ExecutionPolicy Bypass -File .vscode\\setup-local-https.ps1",
      "problemMatcher": []
    },
    {
      "label": "run identity HTTPS dev",
      "type": "shell",
      "command": "rtk proxy uv run --env-file .env python -u ..\\..\\..\\.vscode\\run-local-service.py identity",
      "options": {
        "cwd": "${workspaceFolder}/app/business-api/identity"
      },
      "dependsOn": "prepare local OAuth TLS",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "identity-https"
      },
      "problemMatcher": {
        "owner": "banking-dev",
        "pattern": [
          {
            "regexp": "^(.+):(\\d+): (.+)$",
            "file": 1,
            "line": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Started server process.*",
          "endsPattern": ".*Uvicorn running on https://localhost:8091.*"
        }
      }
    },
    {
      "label": "prepare full stack dev",
      "type": "shell",
      "command": "Write-Output 'Full stack ready'",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "dependsOrder": "sequence",
      "dependsOn": [
        "run identity HTTPS dev",
        "run account mcp dev",
        "run transaction mcp dev",
        "run responses agent dev",
        "run responses bff dev",
        "run frontend dev"
      ]
    }
  ]
}
