{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "defaultConfiguration": "DEV - Full Stack Ordered",
  "configurations": [
    {
      "name": "Account MCP: DEV (Python Main)",
      "type": "debugpy",
      "request": "launch",
      "module": "banking_account.main",
      "env": {
        "PROFILE": "dev"
      },
      "cwd": "${workspaceFolder}/app/business-api/account",
      "console": "integratedTerminal"
    },
    {
      "name": "Transaction MCP: DEV (Python Main)",
      "type": "debugpy",
      "request": "launch",
      "module": "banking_transaction.main",
      "env": {
        "PROFILE": "dev"
      },
      "cwd": "${workspaceFolder}/app/business-api/transaction",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "DEV - Banking Web App",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5170/",
      "webRoot": "${workspaceFolder}/app/frontend/banking-web",
      "preLaunchTask": "prepare full stack dev"
    },

    {
      "name": "DEV - Responses Hosted Agent",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app/agent/main.py",
      "env": {
        "PROFILE": "dev",
        "ENABLE_SENSITIVE_DATA": "true"
      },
      "jinja": true,
      "cwd": "${workspaceFolder}/app/agent",
      "justMyCode": false
    },
    {
      "name": "DEV - Responses BFF",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["bff.main:app", "--port", "8080"],
      "env": {
        "PROFILE": "dev",
        "RESPONSES_UPSTREAM_MODE": "local",
        "RESPONSES_AGENT_ENDPOINT": "http://127.0.0.1:8088/responses"
      },
      "jinja": true,
      "cwd": "${workspaceFolder}/app/responses-bff",
      "justMyCode": false
    }
  ],
  "compounds": [
    {
      "name": "DEV - Full Stack Ordered",
      "configurations": ["DEV - Banking Web App"],
      "stopAll": true
    }
  ]
}
