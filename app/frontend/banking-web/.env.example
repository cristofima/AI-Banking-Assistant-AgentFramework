# Banking Web frontend environment variables
# Copy this file to .env.local for local development.

# Absolute base URLs (including /api) for the separate Account/Transaction App
# Services. Every environment, local and deployed, sets these explicitly; there
# is no dev-server proxy for them.
VITE_ACCOUNT_API_URL=http://localhost:8070/api
VITE_TRANSACTION_API_URL=http://localhost:8071/api

# Responses BFF endpoints used by chat UI components and authentication.
# Every environment sets these explicitly; there is no dev-server proxy.
VITE_RESPONSES_API_URL=http://localhost:8080/responses
VITE_RESPONSES_BFF_URL=http://localhost:8080

# Frontend OAuth consent/callback routes use https://localhost:5170.
# Identity URLs, OAuth client secrets, grants and signing keys belong only to backends.
# VITE_* values are public browser configuration; never put credentials here.
