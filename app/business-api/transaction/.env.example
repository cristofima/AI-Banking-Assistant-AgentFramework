# Local HTTP service port 8071; root tasks also select this development profile.
PROFILE=dev
# Approved local PostgreSQL SQLAlchemy URL; supply credentials privately.
DATABASE_URL=

# Browser REST authentication: match Identity and BFF, independently of MCP OAuth.
# Replace these placeholders with distinct private keys, each at least 32 characters.
JWT_SECRET_KEY=replace-with-shared-jwt-signing-key-at-least-32-characters
JWT_ISSUER=home-banking-api
JWT_AUDIENCE=home-banking-web
AUTH_INTERNAL_SECRET=replace-with-shared-introspection-key-at-least-32-characters
AUTH_USERS_ENDPOINT=https://localhost:8091
CORS_ALLOWED_ORIGINS=https://localhost:5170

# Local direct MCP OAuth: match Identity's issuer/audience and the local agent mode.
# Supply trusted public JWKS JSON as one single-quoted line; never a private key.
# Empty JWKS intentionally fails closed; keys are not fetched at runtime.
MCP_IDENTITY_MODE=oauth
OAUTH_ISSUER=https://localhost:8091
OAUTH_AUDIENCE=banking-mcp
OAUTH_JWKS=

# HMAC compatibility only: explicitly set MCP_IDENTITY_MODE=hmac on MCP and agent.
# Match the BFF/agent transport key; never use JWT_SECRET_KEY or AUTH_INTERNAL_SECRET.
# OAuth verification never falls back to this key.
INTERNAL_IDENTITY_SECRET=replace-with-separate-agent-transport-key-at-least-32-characters

# Optional telemetry; leave empty for local development without Azure export.
APPLICATIONINSIGHTS_CONNECTION_STRING=
