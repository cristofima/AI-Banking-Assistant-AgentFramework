# Approved local PostgreSQL SQLAlchemy URL for explicitly authorized database scripts.
# Supply connection credentials privately; copying this file authorizes no writes.
DATABASE_URL=

# Replace these absolute Windows paths; quoted backslashes are literal in dotenv.
# DATA_PROJECT_DIR anchors resources/default artifacts when commands run from repo root.
DATA_PROJECT_DIR='C:\path\to\repository\app\business-api\data'
DATA_SOURCE_DIR='C:\path\to\banking-data'
# Optional overrides; blank values default to DATA_PROJECT_DIR\artifacts.
# DATA_MANIFEST_DIR is a directory, not a manifest filename.
DATA_ARTIFACTS_DIR=
DATA_MANIFEST_DIR=

# Shared demo password; set a real value only in the ignored .env file
DEMO_USER_PASSWORD=

# Explicit first-admin bootstrap only; use a password distinct from demo users
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
