# Approved local PostgreSQL SQLAlchemy URL; supply credentials privately.
DATABASE_URL=

# Application login JWT and REST introspection: match BFF, Account and Transaction.
# Replace these placeholders with distinct private keys, each at least 32 characters.
JWT_SECRET_KEY=replace-with-shared-jwt-signing-key-at-least-32-characters
JWT_ISSUER=home-banking-api
JWT_AUDIENCE=home-banking-web
AUTH_INTERNAL_SECRET=replace-with-shared-introspection-key-at-least-32-characters
# Absolute login JWT lifetime (1-60 minutes); independent of MCP OAuth token lifetime.
ACCESS_TOKEN_MINUTES=60

# Local MCP OAuth provider; Identity HTTPS is prepared by the root VS Code tasks.
# These URLs enable OAuth routes, which fail closed until signing is configured.
# Clear both URLs to disable OAuth for HMAC-only compatibility.
OAUTH_ISSUER=https://localhost:8091
OAUTH_FRONTEND_AUTHORIZE_URL=https://localhost:5170/oauth/consent
OAUTH_AUDIENCE=banking-mcp
# Supply a key ID and unencrypted RSA PEM (at least 2048 bits) privately.
# In an ignored dotenv, use a quoted multiline PEM with real line breaks.
OAUTH_SIGNING_KEY_ID=
OAUTH_SIGNING_PRIVATE_KEY=

# Explicit client provisioning CLI only (32-512 characters); no startup registration.
# Client ID and exact HTTPS callback are CLI arguments, not Identity settings.
OAUTH_CLIENT_SECRET=

# Optional telemetry; leave empty for local development without Azure export.
APPLICATIONINSIGHTS_CONNECTION_STRING=
