# Local development: Azure CLI credentials and direct MCP HTTP connections.
# Local runtime still uses Foundry models; it is not offline execution.
AGENT_RUNTIME=local
# Keep this mode consistent with the BFF and both MCP services.
# Use hmac only for explicit compatibility mode, never as an OAuth failure fallback.
MCP_IDENTITY_MODE=oauth

# Microsoft Foundry project
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
MODEL_DEPLOYMENT_NAME=gpt-5.4
# Optional per-agent deployment names; unset or empty values use MODEL_DEPLOYMENT_NAME.
# MODEL_DEPLOYMENT_NAME may be unset when all three overrides are nonempty.
# Configure only names of deployments available in the same Foundry project.
# TRIAGE_MODEL_DEPLOYMENT_NAME=model-router
# ACCOUNT_MODEL_DEPLOYMENT_NAME=gpt-5.4
# TRANSACTION_MODEL_DEPLOYMENT_NAME=gpt-5.4

# Optional Application Insights export; omit until a real connection string is supplied.
# ENABLE_OTEL is not wired into the Responses entrypoint and is not a telemetry switch.
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# Direct MCP servers: required for local runtime; canonical paths avoid redirects.
ACCOUNT_MCP_URL=http://localhost:8070/mcp/
TRANSACTION_MCP_URL=http://localhost:8071/mcp/

# BFF-to-agent signing secret: required in both OAuth and HMAC modes.
# Must match the BFF; HMAC mode also requires the same value in both MCP services.
# Separate from AUTH_INTERNAL_SECRET; never put OAuth grants or client secrets here.
INTERNAL_IDENTITY_SECRET=replace-with-at-least-32-random-characters

# Hosted runtime only: optional user-assigned managed identity client ID.
# Leave unset for system-assigned managed identity; local runtime uses Azure CLI.
# AZURE_CLIENT_ID=