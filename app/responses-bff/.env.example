# Local browser-to-BFF-to-agent path; never point the browser at the agent.
PROFILE=dev
RESPONSES_UPSTREAM_MODE=local
RESPONSES_AGENT_ENDPOINT=http://127.0.0.1:8088/responses
ALLOWED_ORIGINS=["https://localhost:5170"]

# Banking login: match Identity and both business APIs; no database credentials here.
JWT_SECRET_KEY=replace-with-shared-jwt-signing-key-at-least-32-characters
JWT_ISSUER=home-banking-api
JWT_AUDIENCE=home-banking-web
AUTH_USERS_ENDPOINT=https://localhost:8091
AUTH_INTERNAL_SECRET=replace-with-shared-introspection-key-at-least-32-characters

# Signed BFF-to-agent envelope; separate from the Identity introspection secret.
INTERNAL_IDENTITY_SECRET=replace-with-separate-agent-transport-key-at-least-32-characters

# MCP OAuth: match the agent and both MCP services. HMAC is explicit compatibility only.
# Register a confidential client at Identity separately; copying this file does not register it.
# Supply OAuth variables in the process environment (root tasks or uv --env-file).
MCP_IDENTITY_MODE=oauth
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://localhost:5170/oauth/callback
OAUTH_ISSUER=https://localhost:8091
# Shared example, not a runtime default; match Identity and both MCP validators exactly.
OAUTH_AUDIENCE=banking-mcp
# Single-line public JWKS JSON matching Identity; never include private key material.
OAUTH_JWKS=

# Optional server-side Azure authentication for a hosted upstream.
# RESPONSES_TOKEN_SCOPE=https://ai.azure.com/.default
# AZURE_CLIENT_ID=

# Optional Azure Monitor export; omit until a real connection string is supplied.
# APPLICATIONINSIGHTS_CONNECTION_STRING=
